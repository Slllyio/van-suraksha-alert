# Copy to .env on the server and fill in by hand. Never commit .env, never paste these in chat.
SITE=                       # 1-2-3-4.sslip.io (use the server's IP with dashes) or your own domain
FS_SERVICE_KEYS=            # long random string; eNetra and the runner send it as X-Api-Key (openssl rand -hex 32)
FS_SERVICE_KEY=             # the same string, for the runner
FS_WEBHOOK_URL=             # eNetra's webhook, when ready
FS_WEBHOOK_SECRET=
# NASA Earthdata (HLS and MODIS from LP DAAC): the proxy that signs these calls in the cloud session does not exist on
# a server, so the runner needs the account's token here. Create one at https://urs.earthdata.nasa.gov (Generate Token).
EARTHDATA_TOKEN=
# Copernicus Data Space OAuth client (direction arrow): optional, leave empty to switch the arrow's fresh-scene read off.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
