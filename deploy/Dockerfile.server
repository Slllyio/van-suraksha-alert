# Van Suraksha Alert System — Production Server
# Optimized for Oracle Cloud Free Tier (ARM64/AMD64)
# Runs: daily alert pipeline + portal dashboard + streamlit

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Kolkata

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        gdal-bin libgdal-dev libgeos-dev libproj-dev \
        gcc g++ cron curl supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /app

# Python dependencies (cached layer)
COPY deploy/requirements.server.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Application code
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY dashboard/ ./dashboard/
COPY config.yaml ./
COPY .env ./

# Data (models + fire detections + weather + AOI)
COPY models/ignition/ ./models/ignition/
COPY data/aoi/ ./data/aoi/
COPY data_lake/fire_detections/ ./data_lake/fire_detections/
COPY data_lake/fire_weather/ ./data_lake/fire_weather/
COPY data_lake/alerts/ ./data_lake/alerts/
COPY data_lake/land_cover/ ./data_lake/land_cover/

# Create required directories
RUN mkdir -p outputs/dashboard_feed logs data_lake/alerts \
    data_lake/fire_detections/firms_viirs_nrt

# Cron job: daily at 06:00 AM IST
RUN echo "0 6 * * * cd /app && /usr/local/bin/python scripts/daily_fire_alert.py >> /app/logs/cron.log 2>&1" > /etc/cron.d/fire-alert \
    && chmod 0644 /etc/cron.d/fire-alert \
    && crontab /etc/cron.d/fire-alert

# Supervisor config (runs all services)
COPY deploy/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Ports: 8787 (portal), 8501 (streamlit), 8000 (API)
EXPOSE 8787 8501 8000

# Health check
HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8787/ || exit 1

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
