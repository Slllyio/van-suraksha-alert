# Google Earth Engine
GEE_PROJECT=ee-akshayr1
GEE_SERVICE_ACCOUNT=

# NASA FIRMS API
FIRMS_MAP_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini API (for VLM features)
GOOGLE_API_KEY=

# Dashboard
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0

# Slack (optional)
SLACK_WEBHOOK=

# ── Offline AI (Local RAG) ────────────────────────────────
# Start with: docker compose --profile ai up -d
VS_QDRANT_URL=http://localhost:6333
VS_OLLAMA_URL=http://localhost:11434
OLLAMA_NUM_GPU=0          # 0 = CPU only (safe default for field laptops)

# ── Offline Maps (PMTiles) ────────────────────────────────
VS_PMTILES_DIR=data/tiles/pmtiles
VS_BASEMAP_ASSETS_DIR=data/tiles/basemap-assets
